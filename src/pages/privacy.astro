---
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<title>Privacy | Marco Thoma</title>

		<meta
			name="description"
			content="Privacy information for marcothoma.com, including website hosting, technical data and contact information."
		/>

		<link rel="canonical" href="https://marcothoma.com/privacy" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#101312" />
		<Analytics />
	</head>

	<body>
		<a class="skip-link" href="#main-content">
			Skip to main content
		</a>

		<header class="page-header">
			<a class="logo" href="/">MT</a>

			<a class="back-link" href="/">
				<span>←</span>
				Back home
			</a>
		</header>

		<main id="main-content">

			<!-- HERO -->
			<section class="privacy-hero">

				<p class="eyebrow">PRIVACY</p>

				<h1>
					Privacy,<br />
					<span>clearly explained.</span>
				</h1>

				<p class="hero-intro">
					This privacy statement explains how personal data may be
					processed when you visit marcothoma.com or contact me.
				</p>

				<p class="effective-date">
					Effective 20 September 2026
				</p>

			</section>


			<!-- CONTROLLER -->
			<section class="privacy-section">

				<div class="section-number">01 / CONTROLLER</div>

				<div class="section-copy">

					<h2>Who is responsible?</h2>

					<p>
						The person responsible for the processing of personal data
						in connection with this website is:
					</p>

					<div class="contact-block">
						<p>
							<strong>Marco Thoma</strong><br />
							Switzerland<br />
							<a href="mailto:marcothoma@bluewin.ch">
								marcothoma@bluewin.ch
							</a>
						</p>
					</div>

					<p>
						You can use the email address above for any questions
						concerning privacy or the processing of your personal data.
					</p>

				</div>

			</section>


			<!-- WEBSITE VISITS -->
			<section class="privacy-section">

				<div class="section-number">02 / WEBSITE VISITS</div>

				<div class="section-copy">

					<h2>Data processed when you visit this website.</h2>

					<p>
						This website is hosted by Vercel. When you access the
						website, technical information necessary to deliver and
						secure the website may be processed by the hosting
						infrastructure.
					</p>

					<p>This can include information such as:</p>

					<ul>
						<li>your IP address;</li>
						<li>the date and time of a request;</li>
						<li>the page or file requested;</li>
						<li>browser, device and system information;</li>
						<li>approximate location derived from the IP address;</li>
						<li>technical request and log information.</li>
					</ul>

					<p>
						This information is processed for the technical delivery,
						security, stability and operation of the website.
					</p>

				</div>

			</section>


			<!-- EMAIL -->
			<section class="privacy-section">

				<div class="section-number">03 / CONTACT</div>

				<div class="section-copy">

					<h2>When you contact me.</h2>

					<p>
						If you contact me by email or through the contact form on this
						website, I process the information that you provide in order to
						respond to your request and communicate with you.
					</p>

					<p>
						The contact form collects your name, email address, subject and
						message. Form submissions are processed through
						<strong>Formspree</strong>, a third-party form processing service,
						and are also forwarded to my email address.
					</p>

					<p>
						Please only provide personal information that is necessary for
						your request.
					</p>

				</div>

			</section>


			<!-- COOKIES -->
			<section class="privacy-section">

				<div class="section-number">04 / COOKIES & ANALYTICS</div>

				<div class="section-copy">

					<h2>Privacy-friendly website analytics.</h2>

					<p>
						This website uses <strong>Vercel Web Analytics</strong> to better
						understand how the website is used, for example which pages are
						visited and how visitors reach the website.
					</p>

					<p>
						Vercel Web Analytics does not use third-party cookies for visitor
						identification. Analytics data is collected for aggregated
						statistics and is not associated with an individual visitor or
						their IP address.
					</p>

					<p>
						The information collected may include the page visited, referrer,
						approximate geographic location, device type, operating system and
						browser information. Visitor identification is based on a temporary
						hash that is discarded after 24 hours.
					</p>

				</div>

			</section>


			<!-- THIRD PARTIES -->
			<section class="privacy-section">

				<div class="section-number">05 / SERVICE PROVIDERS</div>

				<div class="section-copy">

					<h2>Hosting and third-party services.</h2>

					<p>
						This website is hosted by <strong>Vercel</strong>. Vercel also provides
						the Web Analytics service used on this website. In connection with
						hosting and analytics, technical and usage-related information may be
						processed by Vercel.
					</p>

					<p>
						Depending on the infrastructure used by the service
						provider, data may also be processed outside Switzerland.
						Vercel provides contractual mechanisms for international
						data transfers, including safeguards applicable to data
						transfers from Switzerland where required.
					</p>

					<p>
						The contact form on this website is processed using services provided
						by <strong>Formspree</strong>. When you submit the form, the information
						you enter is transmitted to Formspree for processing and delivery to me.
					</p>

					<p>
						This website also contains ordinary links to external
						websites such as LinkedIn and GitHub. When you follow an
						external link, the privacy practices of the respective
						provider apply.
					</p>

				</div>

			</section>


			<!-- RETENTION -->
			<section class="privacy-section">

				<div class="section-number">06 / RETENTION</div>

				<div class="section-copy">

					<h2>How long data is kept.</h2>

					<p>
						Personal data is retained only for as long as necessary
						for the purpose for which it was processed or as required
						by applicable law.
					</p>

					<p>
						Technical data processed by the hosting provider is subject to the
						provider's applicable retention practices. Information received by email
						or through the contact form may be retained for as long as reasonably
						necessary to respond to the request and maintain relevant correspondence.
						Form submissions may also be temporarily stored by Formspree according
						to the retention period applicable to my Formspree account.
					</p>

				</div>

			</section>


			<!-- RIGHTS -->
			<section class="privacy-section">

				<div class="section-number">07 / YOUR RIGHTS</div>

				<div class="section-copy">

					<h2>Your data, your rights.</h2>

					<p>
						Subject to applicable data protection law, you may have
						rights relating to your personal data, including rights to
						request access, correction or deletion of personal data.
					</p>

					<p>
						To exercise such rights or ask a privacy-related question,
						please contact:&nbsp;
						<a href="mailto:marcothoma@bluewin.ch">
							marcothoma@bluewin.ch
						</a>.
					</p>

					<p>
						You may also contact the Swiss Federal Data Protection and
						Information Commissioner (FDPIC) regarding data protection
						matters.
					</p>

				</div>

			</section>


			<!-- CHANGES -->
			<section class="privacy-section">

				<div class="section-number">08 / CHANGES</div>

				<div class="section-copy">

					<h2>Changes to this privacy statement.</h2>

					<p>
						This privacy statement may be updated if the website,
						services used or applicable data-processing activities
						change. The version published on this page is the current
						version.
					</p>

					<p class="attribution">
						Based on DSAT.ch.
					</p>

				</div>

			</section>

		</main>


		<footer>
			<p class="footer-site">marcothoma.com</p>

			<div class="footer-center">
				<p>Designed & built by Marco Thoma</p>

				<div class="footer-legal">
					<a href="/privacy">Privacy</a>
					<span aria-hidden="true">·</span>
					<a href="/legal-notice">Legal Notice</a>
				</div>
			</div>

			<p class="footer-copy">© 2026</p>
		</footer>

	</body>
</html>


<style>
	:root {
		--background: #f7f7f5;
		--text: #101312;
		--muted: #626966;
		--light-muted: #858b88;
		--border: #d9ddda;
		--accent: #deac53;
		--accent-text: #8f6210;
		--page-padding: clamp(28px, 4vw, 76px);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--background);
		color: var(--text);
		font-family: Arial, Helvetica, sans-serif;
	}

	a {
		color: inherit;
	}


	/* HEADER */

	.page-header {
		height: 84px;
		padding: 0 var(--page-padding);
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}

	.logo {
		font-size: 22px;
		font-weight: 750;
		text-decoration: none;
	}

	.back-link {
		display: flex;
		gap: 10px;
		align-items: center;
		font-size: 12px;
		text-decoration: none;
	}

	.back-link span {
		color: var(--accent);
		transition: transform 0.2s ease;
	}

	.back-link:hover span {
		transform: translateX(-4px);
	}


	/* SKIP LINK */

	.skip-link {
		position: fixed;
		top: 12px;
		left: 50%;
		z-index: 9999;
		padding: 12px 16px;
		background: #101312;
		color: #ffffff;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transform: translate(-50%, -150%);
		transition: transform 0.2s ease;
	}

	.skip-link:focus {
		transform: translate(-50%, 0);
	}


	/* HERO */

	.privacy-hero {
		padding: 110px var(--page-padding) 120px;
	}

	.eyebrow {
		margin: 0 0 24px;
		color: var(--light-muted);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.privacy-hero h1 {
		max-width: 950px;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(52px, 7vw, 96px);
		font-weight: 400;
		line-height: 0.98;
		letter-spacing: -0.045em;
	}

	.privacy-hero h1 span {
		color: var(--accent);
	}

	.hero-intro {
		max-width: 690px;
		margin: 38px 0 0;
		color: var(--muted);
		font-size: 17px;
		line-height: 1.75;
	}

	.effective-date {
		margin: 34px 0 0;
		color: var(--light-muted);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}


	/* PRIVACY CONTENT */

	.privacy-section {
		display: grid;
		grid-template-columns: minmax(130px, 0.23fr) 1fr;
		gap: 60px;
		padding: 80px var(--page-padding);
		border-top: 1px solid var(--border);
	}

	.section-number {
		padding-top: 8px;
		color: var(--light-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.section-copy {
		max-width: 850px;
	}

	.section-copy h2 {
		margin: 0 0 32px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(30px, 3vw, 44px);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.section-copy p,
	.section-copy li {
		color: var(--muted);
		font-size: 15px;
		line-height: 1.8;
	}

	.section-copy p {
		margin: 0 0 20px;
	}

	.section-copy p:last-child {
		margin-bottom: 0;
	}

	.section-copy ul {
		margin: 24px 0 28px;
		padding-left: 20px;
	}

	.section-copy li {
		padding-left: 6px;
		margin-bottom: 6px;
	}

	.section-copy a {
		text-decoration-color: var(--accent);
		text-underline-offset: 3px;
	}

	.section-copy strong {
		color: var(--text);
		font-weight: 700;
	}

	.contact-block {
		margin: 28px 0;
		padding: 24px 28px;
		border-left: 2px solid var(--accent);
		background: #eeeeeb;
	}

	.contact-block p {
		margin: 0;
	}

	.attribution {
		margin-top: 42px !important;
		color: var(--light-muted) !important;
		font-size: 11px !important;
	}


	/* FOOTER */

	/* FOOTER */

	footer {
		min-height: 88px;
		padding: 14px var(--page-padding);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: center;
		font-size: 10px;
		color: var(--muted);
		border-top: 1px solid var(--border);
	}

	footer p {
		margin: 0;
	}

	.footer-center {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 7px;
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.footer-legal a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-legal a:hover {
		color: var(--text);
	}

	.footer-legal span {
		color: var(--muted);
	}

	.footer-copy {
		text-align: right;
	}


	/* TABLET */

	@media (max-width: 900px) {

		.privacy-hero {
			padding-top: 80px;
			padding-bottom: 90px;
		}

		.privacy-section {
			grid-template-columns: 1fr;
			gap: 30px;
			padding-top: 65px;
			padding-bottom: 65px;
		}

	}


	/* MOBILE */

	@media (max-width: 600px) {

		.page-header {
			height: 70px;
		}

		.privacy-hero {
			padding-top: 60px;
			padding-bottom: 75px;
		}

		.privacy-hero h1 {
			font-size: 48px;
		}

		.hero-intro {
			font-size: 15px;
		}

		.privacy-section {
			padding-top: 55px;
			padding-bottom: 55px;
		}

		.section-copy h2 {
			font-size: 30px;
		}

		footer {
			grid-template-columns: 1fr auto;
			gap: 8px 20px;
			padding-top: 22px;
			padding-bottom: 22px;
		}

		.footer-site {
			grid-column: 1;
			grid-row: 1;
		}

		.footer-center {
			grid-column: 1 / -1;
			grid-row: 2;
			align-items: flex-start;
			gap: 7px;
		}

		.footer-copy {
			grid-column: 2;
			grid-row: 1;
			text-align: right;
		}
	}


	@media (prefers-reduced-motion: reduce) {

		html {
			scroll-behavior: auto;
		}

		.back-link span,
		.skip-link {
			transition: none;
		}

	}


	a:focus-visible,
	button:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 2px;
		box-shadow: 0 0 0 5px #101312;
	}
</style>