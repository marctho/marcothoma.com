---
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<title>About | Marco Thoma</title>

		<meta
			name="description"
			content="Learn more about Marco Thoma, his background in People-Oriented Computing, information systems, business and human-centered technology."
		/>

		<link rel="canonical" href="https://marcothoma.com/about" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#101312" />
		<Analytics />
	</head>

	<body>
		<a class="skip-link" href="#main-content">
			Skip to main content
		</a>
		<header class="about-header">
			<a class="logo" href="/">MT</a>

			<a class="back-link" href="/">
				<span>←</span>
				Back home
			</a>
		</header>

		<main id="main-content">

			<!-- HERO -->
			<section class="about-hero">

				<div class="hero-main">

					<p class="eyebrow">ABOUT ME</p>

					<h1>
						My curiosity lies in understanding how things work —
						especially when <span>people and technology</span> meet.
					</h1>

					<p class="hero-intro">
						My background combines information systems, business and
						human-computer interaction. Over time, I became increasingly
						interested not only in what technology can do, but in how
						people understand it, interact with it and ultimately benefit
						from it.
					</p>

				</div>

				<div class="hero-aside">
					<div class="portrait">
						<img
							src="/images/about/marco-thoma.jpg"
							alt="Portrait of Marco Thoma"
							width="1181"
							height="1181"
						/>
					</div>

					<div class="hero-side">
						<span>CURRENTLY</span>

						<p>
							Based in Zurich.<br />
							Exploring opportunities.<br />
							Always curious.
						</p>
					</div>

				</div>

			</section>


			<!-- JOURNEY -->
			<section class="content-section">

				<div class="section-number">01 / JOURNEY</div>

				<div class="section-content">

					<h2>
						From information systems to human-centered technology.
					</h2>

					<div class="two-column-text journey-text">

						<p>
							I started with Business Information Systems because I was
							interested in both technology and the way organisations use
							it. That combination gave me a broad perspective on digital
							systems — not only from a technical side, but also from a
							business and organisational one.
						</p>

						<p>
							During my Master's in People-Oriented Computing, my focus
							moved increasingly toward the people using those systems.
							Human-computer interaction, user understanding and
							user-centered research became central themes in my work.
						</p>

					</div>

					<div class="journey-grid">

						<div>
							<span>2019 — 2023</span>

							<h3>BSc Business Information Systems</h3>

							<p>
								University of Zurich<br />
								Minor in Business Administration
							</p>
						</div>

						<div>
							<span>2023 — 2026</span>

							<h3>MSc People-Oriented Computing</h3>

							<p>
								University of Zurich<br />
								Minor in Business Administration
							</p>
						</div>

					</div>

				</div>

			</section>


			<!-- INTERESTS -->
			<section class="interests-section">

				<p class="eyebrow">WHAT INTERESTS ME</p>

				<h2>
					Technology becomes most interesting to me when the
					human side matters.
				</h2>

				<div class="interest-grid">

					<div>
						<span>01</span>

						<h3>User understanding</h3>

						<p>
							How people interpret interfaces, algorithms and complex
							digital systems — and how design can make those systems
							easier to understand.
						</p>
					</div>

					<div>
						<span>02</span>

						<h3>Digital products</h3>

						<p>
							How research, technology and design come together to create
							products that are useful, understandable and well designed.
						</p>
					</div>

					<div>
						<span>03</span>

						<h3>AI & human interaction</h3>

						<p>
							How increasingly capable AI systems affect the way people
							make decisions, understand information and interact with
							technology.
						</p>
					</div>

				</div>

			</section>


			<!-- APPROACH -->
			<section class="content-section muted-section">

				<div class="section-number">02 / APPROACH</div>

				<div class="section-content">

					<h2>
						My approach is to look at problems from more than one angle.
					</h2>

					<div class="approach-grid">

						<div>
							<span>PEOPLE</span>

							<h3>Human-centered</h3>

							<p>
								I like starting with the people involved: what they
								need, how they behave and where technology can genuinely
								make something easier or better.
							</p>
						</div>

						<div>
							<span>ANALYSIS</span>

							<h3>Structured</h3>

							<p>
								Research, qualitative analysis and quantitative data
								help me break complex questions into something that can
								be understood and acted on.
							</p>
						</div>

						<div>
							<span>TECHNOLOGY</span>

							<h3>Practical</h3>

							<p>
								Turning ideas into something tangible starts with
								understanding how digital systems work — whether through
								prototyping, development or visualisation.
							</p>
						</div>

						<div>
							<span>BUSINESS</span>

							<h3>Interdisciplinary</h3>

							<p>
								My background in information systems and business helps
								me think beyond the interface and consider the wider
								context in which technology is used.
							</p>
						</div>

					</div>

				</div>

			</section>


			<!-- EXPERIENCE -->
			<section class="experience-section">

				<div>

					<p class="eyebrow">EXPERIENCE</p>

					<h2>
						Learning across research, technology and business.
					</h2>

				</div>

				<div class="experience-copy">

					<p>
						Alongside my studies, I gained experience in the Pharma and
						MedTech consulting environment at Eraneos, supporting market
						and technology analyses, customer journeys, structured
						information analysis and project materials.
					</p>

					<p>
						My academic work has ranged from building an interactive
						health-data application to conducting user studies on
						recommender-system explanations and qualitative research on
						generative AI in customer feedback.
					</p>

					<a href="/#experience" class="text-link">
						View experience
						<span>→</span>
					</a>

				</div>

			</section>


			<!-- WORK -->
			<section class="work-section">

				<p class="eyebrow">SELECTED WORK</p>

				<div class="work-heading">

					<h2>
						A few examples of how those interests come together.
					</h2>

					<a href="/#work">
						View projects
						<span>→</span>
					</a>

				</div>

				<div class="work-links">

					<a href="/work/recommender-systems">
						<span>01</span>
						<p>Recommender Systems & User Understanding</p>
						<strong>→</strong>
					</a>

					<a href="/work/type-1-diabetes">
						<span>02</span>
						<p>Web Application for Type 1 Diabetes Management</p>
						<strong>→</strong>
					</a>

					<a href="/work/ai-customer-feedback">
						<span>03</span>
						<p>AI in Customer Feedback Management</p>
						<strong>→</strong>
					</a>

				</div>

			</section>


			<!-- CTA -->
			<section class="about-cta">

				<div>
					<p class="eyebrow">LET'S CONNECT</p>

					<h2>
						Interested in where people, technology and business come together?
					</h2>
				</div>

				<a href="/contact">
					Get in touch
					<span>→</span>
				</a>

			</section>

		</main>

		<footer>
			<p class="footer-site">marcothoma.com</p>

			<div class="footer-center">
				<p>Designed & built by Marco Thoma</p>

				<div class="footer-legal">
					<a href="/privacy">Privacy</a>
					<span aria-hidden="true">·</span>
					<a href="/legal-notice">Legal Notice</a>
				</div>
			</div>

			<p class="footer-copy">© 2026</p>
		</footer>

	</body>
</html>


<style>
	:root {
		--background: #f7f7f5;
		--text: #101312;
		--muted: #626966;
		--light-muted: #858b88;
		--border: #d9ddda;
		--accent: #deac53;
		--accent-text: #8f6210;
		--dark: #0b100e;
		--page-padding: clamp(28px, 4vw, 76px);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--background);
		color: var(--text);
		font-family: Arial, Helvetica, sans-serif;
	}

	a {
		color: inherit;
	}


	/* HEADER */

	.about-header {
		height: 84px;
		padding: 0 var(--page-padding);
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}

	.logo {
		font-size: 22px;
		font-weight: 750;
		text-decoration: none;
	}

	.back-link {
		display: flex;
		gap: 10px;
		align-items: center;
		font-size: 12px;
		text-decoration: none;
	}

	.back-link span {
		color: var(--accent);
		transition: transform 0.2s ease;
	}

	.back-link:hover span {
		transform: translateX(-4px);
	}


	/* GENERAL */

	.eyebrow {
		margin: 0 0 22px;
		color: var(--light-muted);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.content-section {
		display: grid;
		grid-template-columns: minmax(130px, 0.23fr) 1fr;
		gap: 60px;
		padding: 110px var(--page-padding);
		border-top: 1px solid var(--border);
	}

	.section-number {
		padding-top: 9px;
		color: var(--light-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.section-content h2,
	.interests-section h2,
	.experience-section h2,
	.work-section h2,
	.about-cta h2 {
		max-width: 950px;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(34px, 4vw, 56px);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.two-column-text {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(40px, 7vw, 110px);
		max-width: 1100px;
		margin-top: 42px;
	}

	.two-column-text p {
		margin: 0;
		color: var(--muted);
		font-size: 15px;
		line-height: 1.8;
	}

    .journey-text {
        max-width: none;
        gap: 0;
    }

    .journey-text p {
        max-width: 560px;
        padding: 0 28px;
    }

	.muted-section {
		background: #eeeeeb;
	}

	.skip-link {
		position: fixed;
		top: 12px;
		left: 50%;
		z-index: 9999;
		padding: 12px 16px;
		background: #101312;
		color: #ffffff;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transform: translate(-50%, -150%);
		transition: transform 0.2s ease;
	}

	.skip-link:focus {
		transform: translate(-50%, 0);
	}


	/* HERO */

	.about-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
		gap: clamp(60px, 7vw, 120px);
		padding: 110px var(--page-padding) 120px;
	}

	.hero-main h1 {
		max-width: 1050px;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(48px, 6vw, 88px);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.045em;
	}

	.hero-main h1 span {
		color: var(--accent);
	}

	.hero-intro {
		max-width: 760px;
		margin: 38px 0 0;
		color: var(--muted);
		font-size: 17px;
		line-height: 1.75;
	}

	.hero-aside {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	.portrait {
		width: 100%;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		border: 1px solid var(--border);
		background: #eeeeeb;
	}

	.portrait img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-side {
		padding-top: 18px;
		border-top: 1px solid var(--accent);
	}

	.hero-side span {
		color: var(--light-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.15em;
	}

	.hero-side p {
		margin: 18px 0 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 25px;
		line-height: 1.4;
	}


	/* JOURNEY */

	.journey-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		margin-top: 60px;
		border-top: 1px solid var(--border);
		border-left: 1px solid var(--border);
	}

	.journey-grid > div {
		min-height: 230px;
		padding: 28px;
		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.journey-grid span {
		color: var(--accent-text);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.journey-grid h3 {
		margin: 48px 0 10px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 27px;
		font-weight: 400;
	}

	.journey-grid p {
		margin: 0;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.7;
	}


	/* INTERESTS */

	.interests-section {
		padding: 110px var(--page-padding);
		background: var(--dark);
		color: white;
	}

	.interests-section .eyebrow {
		color: rgba(255,255,255,0.4);
	}

	.interest-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin-top: 65px;
		border-top: 1px solid rgba(255,255,255,0.15);
		border-left: 1px solid rgba(255,255,255,0.15);
	}

	.interest-grid > div {
		min-height: 300px;
		padding: 30px;
		border-right: 1px solid rgba(255,255,255,0.15);
		border-bottom: 1px solid rgba(255,255,255,0.15);
	}

	.interest-grid span {
		color: var(--accent);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 24px;
	}

	.interest-grid h3 {
		margin: 52px 0 15px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 28px;
		font-weight: 400;
	}

	.interest-grid p {
		margin: 0;
		max-width: 390px;
		color: rgba(255,255,255,0.58);
		font-size: 13px;
		line-height: 1.75;
	}


	/* APPROACH */

	.approach-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		margin-top: 60px;
		border-top: 1px solid var(--border);
		border-left: 1px solid var(--border);
	}

	.approach-grid > div {
		min-height: 260px;
		padding: 30px;
		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.approach-grid span {
		color: var(--accent-text);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.approach-grid h3 {
		margin: 48px 0 14px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 27px;
		font-weight: 400;
	}

	.approach-grid p {
		margin: 0;
		max-width: 500px;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.75;
	}


	/* EXPERIENCE */

	.experience-section {
		display: grid;
		grid-template-columns: 1fr 0.75fr;
		gap: 100px;
		padding: 110px var(--page-padding);
		border-top: 1px solid var(--border);
	}

	.experience-copy {
		padding-top: 35px;
	}

	.experience-copy p {
		margin: 0 0 22px;
		color: var(--muted);
		font-size: 15px;
		line-height: 1.8;
	}

	.text-link {
		display: inline-flex;
		gap: 22px;
		align-items: center;
		margin-top: 15px;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
	}

	.text-link span {
		color: var(--accent);
		transition: transform 0.2s ease;
	}

	.text-link:hover span {
		transform: translateX(4px);
	}


	/* WORK */

	.work-section {
		padding: 110px var(--page-padding);
		background: #eeeeeb;
	}

	.work-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 50px;
	}

	.work-heading > a {
		display: flex;
		gap: 20px;
		text-decoration: none;
		font-size: 13px;
	}

	.work-heading > a span {
		color: var(--accent);
	}

	.work-links {
		margin-top: 65px;
		border-top: 1px solid var(--border);
	}

	.work-links a {
		display: grid;
		grid-template-columns: 80px 1fr auto;
		gap: 25px;
		align-items: center;
		padding: 28px 0;
		border-bottom: 1px solid var(--border);
		text-decoration: none;
	}

	.work-links span {
		color: var(--accent-text);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 20px;
	}

	.work-links p {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(21px, 2vw, 30px);
	}

	.work-links strong {
		font-size: 20px;
		font-weight: 400;
		transition: transform 0.2s ease;
	}

	.work-links a:hover strong {
		transform: translateX(5px);
	}


	/* CTA */

	.about-cta {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 70px;
		align-items: end;
		padding: 100px var(--page-padding);
		background: var(--accent);
	}

	.about-cta .eyebrow {
		color: rgba(16,19,18,0.55);
	}

	.about-cta a {
		display: flex;
		align-items: center;
		gap: 25px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 28px;
		text-decoration: none;
	}

	.about-cta a span {
		transition: transform 0.2s ease;
	}

	.about-cta a:hover span {
		transform: translateX(5px);
	}


	/* FOOTER */

	/* FOOTER */

	footer {
		min-height: 88px;
		padding: 14px var(--page-padding);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: center;
		font-size: 10px;
		color: var(--muted);
	}

	footer p {
		margin: 0;
	}

	.footer-center {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 7px;
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.footer-legal a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-legal a:hover {
		color: var(--text);
	}

	.footer-legal span {
		color: var(--muted);
	}

	.footer-copy {
		text-align: right;
	}


	/* TABLET */

	@media (max-width: 900px) {

		.about-hero {
			grid-template-columns: 1fr;
			gap: 60px;
			padding-top: 80px;
		}

		.hero-aside {
			width: 100%;
			max-width: 340px;
			margin-left: auto;
		}

		.content-section {
			grid-template-columns: 1fr;
			gap: 32px;
			padding-top: 80px;
			padding-bottom: 80px;
		}

		.two-column-text,
		.experience-section {
			grid-template-columns: 1fr;
		}

		.about-cta {
			grid-template-columns: 1fr auto;
			align-items: end;
		}

		.journey-grid,
		.approach-grid {
			grid-template-columns: 1fr;
		}

		.journey-text {
			gap: 28px;
		}

		.interest-grid {
			grid-template-columns: 1fr;
		}
	}


	/* MOBILE */

	@media (max-width: 600px) {

		.about-header {
			height: 70px;
		}

		.about-hero {
			padding-top: 55px;
			padding-bottom: 80px;
		}

		.hero-main h1 {
			font-size: 42px;
		}

		.hero-intro {
			font-size: 15px;
		}

		.hero-aside {
			max-width: 300px;
			margin-left: 0;
		}

		.interests-section,
		.work-section {
			padding-top: 75px;
			padding-bottom: 75px;
		}

		.work-heading {
			align-items: flex-start;
			flex-direction: column;
		}

		.work-links a {
			grid-template-columns: 45px 1fr auto;
			gap: 14px;
		}

		.about-cta {
			grid-template-columns: 1fr;
			align-items: flex-start;
			gap: 35px;
		}

		.experience-section {
			gap: 45px;
		}

		.experience-copy {
			padding-top: 0;
		}

		footer {
			grid-template-columns: 1fr auto;
			gap: 8px 20px;
			padding-top: 22px;
