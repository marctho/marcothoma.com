		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.project-meta p,
	.supervision p {
		margin: 0;
		font-size: 15px;
		line-height: 1.5;
	}


	/* STANDARD CONTENT */

	.content-section {
		display: grid;
		grid-template-columns: minmax(130px, 0.23fr) 1fr;
		gap: 60px;
		padding: 110px var(--page-padding);
		border-top: 1px solid var(--border);
	}

	.section-number {
		padding-top: 9px;
		color: var(--light-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.section-content h2,
	.dataset-heading h2,
	.signals-heading h2,
	.gpt-copy h2,
	.grice-heading h2,
	.findings-section h2,
	.implication-section h2 {
		max-width: 950px;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(34px, 4vw, 56px);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.two-column-text {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(40px, 7vw, 110px);
		max-width: 1100px;
		margin-top: 42px;
	}

	.two-column-text p,
	.wide-copy {
		margin: 0;
		color: var(--muted);
		font-size: 15px;
		line-height: 1.8;
	}

	.wide-copy {
		max-width: 820px;
		margin-top: 38px;
	}

	.secondary-copy {
		margin-top: 18px;
		color: var(--muted);
	}

	.muted-section {
		background: #eeeeeb;
	}


	/* SUPERVISION */

	.supervision {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 30px;
		max-width: 1000px;
		margin-top: 55px;
		padding-top: 28px;
		border-top: 1px solid var(--border);
	}


