		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transform: translate(-50%, -150%);
		transition: transform 0.2s ease;
	}

	.skip-link:focus {
		transform: translate(-50%, 0);
	}

	/* HEADER */

	.project-header {
		height: 84px;
		padding: 0 var(--page-padding);
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}

