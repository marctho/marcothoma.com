		line-height: 1.5;
	}


	/* STANDARD SECTION */

	.content-section {
		display: grid;
		grid-template-columns: minmax(130px, 0.23fr) 1fr;
		gap: 60px;
		padding: 110px var(--page-padding);
		border-top: 1px solid var(--border);
	}

