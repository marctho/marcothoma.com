		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(34px, 4vw, 56px);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.two-column-text {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(40px, 7vw, 110px);
		max-width: 1100px;
		margin-top: 42px;
