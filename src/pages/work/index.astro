<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<title>Work | Marco Thoma</title>

		<meta
			name="description"
			content="Selected work by Marco Thoma across human-computer interaction, visual analytics, recommender systems and AI."
		/>

		<link rel="canonical" href="https://marcothoma.com/work" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#101312" />
	</head>

	<body>
		<a class="skip-link" href="#main-content">
			Skip to main content
		</a>
		<header class="work-header">
			<a class="logo" href="/">MT</a>

			<a class="back-link" href="/">
				<span>←</span>
				Back home
			</a>
		</header>

		<main id="main-content">

			<!-- HERO -->
			<section class="work-hero">
				<p class="eyebrow">SELECTED WORK</p>

				<h1>
					Projects across <span>people, technology</span> and
					digital products.
				</h1>

				<p class="hero-intro">
					A selection of academic projects exploring user understanding,
					interactive systems, data and artificial intelligence.
				</p>
			</section>


			<!-- PROJECTS -->
			<section class="projects">

				<a class="project-row" href="/work/recommender-systems">
					<div class="project-number">01</div>

					<div class="project-image project-one"></div>

					<div class="project-info">
						<p class="project-type">MASTER'S THESIS</p>

						<h2>
							Recommender Systems & User Understanding
						</h2>

						<p class="project-description">
							Investigating how explanation design in recommender
							systems influences user understanding through a
							human-centered research approach.
						</p>

						<div class="tags">
							<span>HCI</span>
							<span>User Research</span>
							<span>Data Analysis</span>
						</div>
					</div>

					<div class="project-arrow">→</div>
				</a>


				<a class="project-row" href="/work/type-1-diabetes">
					<div class="project-number">02</div>

					<div class="project-image project-two"></div>

					<div class="project-info">
						<p class="project-type">MASTER'S PROJECT</p>

						<h2>
							Web Application for Type 1 Diabetes Management
						</h2>

						<p class="project-description">
							A web application combining similarity search and
							interactive visualizations to support exploration of
							multidimensional health data.
						</p>

						<div class="tags">
							<span>Web Development</span>
							<span>Visual Analytics</span>
							<span>Health</span>
						</div>
					</div>

					<div class="project-arrow">→</div>
				</a>


				<a class="project-row" href="/work/ai-customer-feedback">
					<div class="project-number">03</div>

					<div class="project-image project-three"></div>

					<div class="project-info">
						<p class="project-type">BACHELOR'S THESIS</p>

						<h2>
							AI in Customer Feedback Management
						</h2>

						<p class="project-description">
							A qualitative study examining how people distinguish
							human-written from AI-generated responses to online
							customer feedback.
						</p>

						<div class="tags">
							<span>Qualitative Research</span>
							<span>AI</span>
							<span>Information Systems</span>
						</div>
					</div>

					<div class="project-arrow">→</div>
				</a>

			</section>


			<!-- CTA -->
			<section class="work-cta">
				<p>INTERESTED IN MORE?</p>

				<a href="mailto:marcothoma@bluewin.ch">
					Get in touch
					<span>→</span>
				</a>
			</section>

		</main>

		<footer>
			<p class="footer-site">marcothoma.com</p>

			<div class="footer-center">
				<p>Designed & built by Marco Thoma</p>

				<div class="footer-legal">
					<a href="/privacy">Privacy</a>
					<span aria-hidden="true">·</span>
					<a href="/legal-notice">Legal Notice</a>
				</div>
			</div>

			<p class="footer-copy">© 2026</p>
		</footer>
	</body>
</html>


<style>
	:root {
		--background: #f7f7f5;
		--text: #101312;
		--muted: #626966;
		--light-muted: #858b88;
		--border: #d9ddda;
		--accent: #deac53;
		--accent-text: #8f6210;
		--page-padding: clamp(28px, 4vw, 76px);
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--background);
		color: var(--text);
		font-family: Arial, Helvetica, sans-serif;
	}

	a {
		color: inherit;
	}

	.skip-link {
		position: fixed;
		top: 12px;
		left: 50%;
		z-index: 9999;
		padding: 12px 16px;
		background: #101312;
		color: #ffffff;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transform: translate(-50%, -150%);
		transition: transform 0.2s ease;
	}

	.skip-link:focus {
		transform: translate(-50%, 0);
	}

	/* HEADER */

	.work-header {
		height: 84px;
		padding: 0 var(--page-padding);
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}

	.logo {
		font-size: 22px;
		font-weight: 750;
		text-decoration: none;
	}

	.back-link {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 12px;
		text-decoration: none;
	}

	.back-link span {
		color: var(--accent);
		transition: transform 0.2s ease;
	}

	.back-link:hover span {
		transform: translateX(-4px);
	}


	/* HERO */

	.work-hero {
		padding: 100px var(--page-padding) 110px;
		border-bottom: 1px solid var(--border);
	}

	.eyebrow {
		margin: 0 0 24px;
		color: var(--light-muted);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.work-hero h1 {
		max-width: 1100px;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(48px, 6vw, 86px);
		font-weight: 400;
		line-height: 1.03;
		letter-spacing: -0.045em;
	}

	.work-hero h1 span {
		color: var(--accent);
	}

	.hero-intro {
		max-width: 700px;
		margin: 35px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.75;
	}


	/* PROJECTS */

	.projects {
		padding: 0 var(--page-padding);
	}

	.project-row {
		display: grid;
		grid-template-columns: 55px minmax(280px, 0.9fr) 1fr 40px;
		gap: 38px;
		align-items: center;
		padding: 55px 0;
		border-bottom: 1px solid var(--border);
		text-decoration: none;
	}

	.project-number {
		align-self: start;
		padding-top: 5px;
		color: var(--accent-text);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 21px;
	}

	.project-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		border: 1px solid var(--border);
		overflow: hidden;
		transition: transform 0.3s ease;
	}

	.project-one {
		background-image: url('/images/projects/masters-thesis.png');
	}

	.project-two {
		background-image: url('/images/projects/masters-project.png');
	}

	.project-three {
		background-image: url('/images/projects/bachelors-thesis.png');
	}

	.project-type {
		margin: 0 0 18px;
		color: var(--light-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.15em;
	}

	.project-info h2 {
		max-width: 650px;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(27px, 3vw, 42px);
		font-weight: 400;
		line-height: 1.1;
		transition: color 0.2s ease;
	}

	.project-description {
		max-width: 650px;
		margin: 20px 0 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.75;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 25px;
	}

	.tags span {
		padding: 8px 10px;
		background: #eeeeeb;
		font-size: 10px;
	}

	.project-arrow {
		font-size: 24px;
		transition: transform 0.2s ease;
	}

	.project-row:hover .project-image {
		transform: scale(1.015);
	}

	.project-row:hover h2 {
		color: var(--accent);
	}

	.project-row:hover .project-arrow {
		transform: translateX(5px);
	}


	/* CTA */

	.work-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 80px var(--page-padding);
		background: var(--accent);
	}

	.work-cta > p {
		margin: 0;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.work-cta a {
		display: flex;
		align-items: center;
		gap: 30px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(28px, 4vw, 48px);
		text-decoration: none;
	}

	.work-cta a span {
		transition: transform 0.2s ease;
	}

	.work-cta a:hover span {
		transform: translateX(5px);
	}


	/* FOOTER */

	/* FOOTER */

	footer {
		min-height: 88px;
		padding: 14px var(--page-padding);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: center;
		font-size: 10px;
		color: var(--muted);
	}

	footer p {
		margin: 0;
	}

	.footer-center {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 7px;
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.footer-legal a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-legal a:hover {
		color: var(--text);
	}

	.footer-legal span {
		color: var(--muted);
	}

	.footer-copy {
		text-align: right;
	}


	/* TABLET */

	@media (max-width: 900px) {

		.work-hero {
			padding-top: 75px;
			padding-bottom: 80px;
		}

		.project-row {
			grid-template-columns: 45px 1fr;
			gap: 25px;
		}

		.project-image,
		.project-info {
			grid-column: 2;
		}

		.project-arrow {
			display: none;
		}

		.project-number {
			grid-row: 1 / span 2;
		}

		footer {
			grid-template-columns: 1fr;
			gap: 7px;
			padding-top: 22px;
			padding-bottom: 22px;
		}

		footer p:nth-child(2),
		footer p:last-child {
			text-align: left;
		}
	}


	/* MOBILE */

	@media (max-width: 600px) {

		.work-header {
			height: 70px;
		}

		.work-hero {
			padding-top: 55px;
			padding-bottom: 65px;
		}

		.work-hero h1 {
			font-size: 42px;
		}

		.project-row {
			grid-template-columns: 1fr;
			gap: 18px;
			padding: 38px 0;
		}

		.project-number,
		.project-image,
		.project-info {
			grid-column: 1;
			grid-row: auto;
		}

		.project-number {
			font-size: 18px;
		}

		.work-cta {
			flex-direction: column;
			align-items: flex-start;
			gap: 30px;
		}

		footer {
			grid-template-columns: 1fr auto;
			gap: 8px 20px;
			padding-top: 22px;
			padding-bottom: 22px;
		}

		.footer-site {
			grid-column: 1;
			grid-row: 1;
		}

		.footer-center {
			grid-column: 1 / -1;
			grid-row: 2;
			align-items: flex-start;
			gap: 7px;
		}

		.footer-copy {
			grid-column: 2;
			grid-row: 1;
			text-align: right;
		}
	}


	@media (prefers-reduced-motion: reduce) {
		.project-image,
		.project-info h2,
		.project-arrow,
		.back-link span,
		.work-cta a span {
			transition: none;
		}
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 2px;
		box-shadow: 0 0 0 5px #101312;
	}
</style>