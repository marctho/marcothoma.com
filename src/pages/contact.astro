---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<title>Contact | Marco Thoma</title>

		<meta
			name="description"
			content="Get in touch with Marco Thoma."
		/>

		<link rel="canonical" href="https://marcothoma.com/contact" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#101312" />
	</head>

	<body>
		<a class="skip-link" href="#main-content">
			Skip to main content
		</a>

		<header class="page-header">
			<a class="logo" href="/">MT</a>

			<a class="back-link" href="/">
				<span>←</span>
				Back home
			</a>
		</header>

		<main id="main-content">

			<section class="contact-page">

				<div class="contact-intro">

					<p class="eyebrow">CONTACT</p>

					<h1>
						Have something<br />
						<span>in mind?</span>
					</h1>

					<p class="intro-copy">
						Whether it’s about an opportunity, a project or simply
						something worth discussing, feel free to send me a message.
					</p>

					<div class="direct-contact">
						<span>DIRECT CONTACT</span>

						<a href="mailto:marcothoma@bluewin.ch">
							marcothoma@bluewin.ch
						</a>
					</div>

				</div>


				<div class="form-wrapper">

					<form
						id="contact-form"
						action="https://formspree.io/f/mzezezdy"
						method="POST"
					>

						<div class="form-row">

							<div class="form-field">
								<label for="name">Name</label>

								<input
									id="name"
									name="name"
									type="text"
									autocomplete="name"
									required
								/>
							</div>

							<div class="form-field">
								<label for="email">Email</label>

								<input
									id="email"
									name="email"
									type="email"
									autocomplete="email"
									required
								/>
							</div>

						</div>


						<div class="form-field">
							<label for="subject">Subject</label>

							<input
								id="subject"
								name="subject"
								type="text"
								required
							/>
						</div>


						<div class="form-field">
							<label for="message">Message</label>

							<textarea
								id="message"
								name="message"
								rows="7"
								required
							></textarea>
						</div>


						<!-- Honeypot spam protection -->
						<div class="honeypot" aria-hidden="true">
							<label for="_gotcha">Leave this field empty</label>

							<input
								id="_gotcha"
								name="_gotcha"
								type="text"
								tabindex="-1"
								autocomplete="off"
							/>
						</div>


						<div class="form-bottom">

							<p class="privacy-note">
								By submitting this form, you agree that the information
								you provide will be processed in accordance with the&nbsp;
								<a href="/privacy">Privacy Statement</a>.
							</p>

							<button type="submit">
								<span class="button-text">Send message</span>
								<span class="button-arrow">→</span>
							</button>

						</div>


						<p
							id="form-status"
							class="form-status"
							role="status"
							aria-live="polite"
						></p>

					</form>

				</div>

			</section>

		</main>


		<footer>
			<p class="footer-site">marcothoma.com</p>

			<div class="footer-center">
				<p>Designed & built by Marco Thoma</p>

				<div class="footer-legal">
					<a href="/privacy">Privacy</a>
					<span aria-hidden="true">·</span>
					<a href="/legal-notice">Legal Notice</a>
				</div>
			</div>

			<p class="footer-copy">© 2026</p>
		</footer>


		<script>
			const form = document.querySelector<HTMLFormElement>('#contact-form');
			const status = document.querySelector<HTMLElement>('#form-status');
			const submitButton =
				form?.querySelector<HTMLButtonElement>('button[type="submit"]');
			const buttonText =
				form?.querySelector<HTMLElement>('.button-text');

			form?.addEventListener('submit', async (event) => {
				event.preventDefault();

				if (!status || !submitButton || !buttonText) return;

				status.textContent = '';
				status.className = 'form-status';

				submitButton.disabled = true;
				buttonText.textContent = 'Sending...';

				try {
					const response = await fetch(form.action, {
						method: 'POST',
						body: new FormData(form),
						headers: {
							Accept: 'application/json'
						}
					});

					if (response.ok) {
						status.textContent =
							'Thanks! Your message has been sent successfully.';
						status.classList.add('success');

						form.reset();
					} else {
						status.textContent =
							'Something went wrong. Please try again or contact me by email.';
						status.classList.add('error');
					}
				} catch {
					status.textContent =
						'Something went wrong. Please try again or contact me by email.';
					status.classList.add('error');
				} finally {
					submitButton.disabled = false;
					buttonText.textContent = 'Send message';
				}
			});
		</script>

	</body>
</html>


<style>
	:root {
		--background: #f7f7f5;
		--text: #101312;
		--muted: #626966;
		--light-muted: #858b88;
		--border: #d9ddda;
		--accent: #deac53;
		--accent-text: #8f6210;
		--dark: #0b100e;
		--page-padding: clamp(28px, 4vw, 76px);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--background);
		color: var(--text);
		font-family: Arial, Helvetica, sans-serif;
	}

	a {
		color: inherit;
	}


	/* HEADER */

	.page-header {
		height: 84px;
		padding: 0 var(--page-padding);
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}

	.logo {
		font-size: 22px;
		font-weight: 750;
		text-decoration: none;
	}

	.back-link {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 12px;
		text-decoration: none;
	}

	.back-link span {
		color: var(--accent);
		transition: transform 0.2s ease;
	}

	.back-link:hover span {
		transform: translateX(-4px);
	}


	/* SKIP LINK */

	.skip-link {
		position: fixed;
		top: 12px;
		left: 50%;
		z-index: 9999;
		padding: 12px 16px;
		background: #101312;
		color: #ffffff;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transform: translate(-50%, -150%);
		transition: transform 0.2s ease;
	}

	.skip-link:focus {
		transform: translate(-50%, 0);
	}


	/* CONTACT */

	.contact-page {
		min-height: calc(100vh - 172px);
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(480px, 1fr);
		gap: clamp(70px, 9vw, 150px);
		padding: 110px var(--page-padding) 120px;
	}

	.contact-intro {
		max-width: 660px;
	}

	.eyebrow {
		margin: 0 0 24px;
		color: var(--light-muted);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.contact-intro h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(58px, 6vw, 94px);
		font-weight: 400;
		line-height: 0.98;
		letter-spacing: -0.045em;
	}

	.contact-intro h1 span {
		color: var(--accent);
	}

	.intro-copy {
		max-width: 570px;
		margin: 38px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.75;
	}

	.direct-contact {
		margin-top: 65px;
		padding-top: 20px;
		border-top: 1px solid var(--accent);
	}

	.direct-contact span {
		display: block;
		margin-bottom: 16px;
		color: var(--light-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.15em;
	}

	.direct-contact a {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(20px, 2vw, 27px);
		text-decoration: none;
	}

	.direct-contact a:hover {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 5px;
	}


	/* FORM */

	.form-wrapper {
		align-self: start;
		padding: 38px 38px 16px;
		border: 1px solid var(--border);
		background: #eeeeeb;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 22px;
	}

	.form-field {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	label {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	input,
	textarea {
		width: 100%;
		border: 0;
		border-bottom: 1px solid #bfc4c1;
		border-radius: 0;
		padding: 12px 0 13px;
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: 15px;
		outline: none;
		transition: border-color 0.2s ease;
	}

	textarea {
		min-height: 170px;
		resize: vertical;
		line-height: 1.6;
	}

	input:focus,
	textarea:focus {
		border-bottom-color: var(--accent-text);
	}

	.form-bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 35px;
		margin-top: 6px;
	}

	.privacy-note {
		max-width: 430px;
		margin: 0;
		color: var(--muted);
		font-size: 11px;
		line-height: 1.6;
	}

	.privacy-note a {
		text-decoration-color: var(--accent);
		text-underline-offset: 3px;
	}

	button {
		flex-shrink: 0;
		min-height: 52px;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 38px;
		padding: 0 22px;
		border: 0;
		background: var(--text);
		color: #ffffff;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	button:hover:not(:disabled) {
		transform: translateY(-2px);
	}

	button:disabled {
		cursor: wait;
		opacity: 0.65;
	}

	.button-arrow {
		color: var(--accent);
		font-size: 18px;
	}

	.form-status {
        min-height: 24px;
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.5;
	}

	.form-status.success {
		color: #356847;
	}

	.form-status.error {
		color: #9b342c;
	}

	.honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}


	/* FOOTER */

	footer {
		min-height: 88px;
		padding: 14px var(--page-padding);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: center;
		color: var(--muted);
		font-size: 10px;
		border-top: 1px solid var(--border);
	}

	footer p {
		margin: 0;
	}

	.footer-center {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 7px;
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.footer-legal a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-legal a:hover {
		color: var(--text);
	}

	.footer-copy {
		text-align: right;
	}


	/* TABLET */

	@media (max-width: 900px) {

		.contact-page {
			grid-template-columns: 1fr;
			gap: 70px;
			padding-top: 80px;
			padding-bottom: 90px;
		}

		.contact-intro {
			max-width: 720px;
		}

		.direct-contact {
			max-width: 420px;
		}

		.form-wrapper {
			width: 100%;
		}

	}


	/* MOBILE */

	@media (max-width: 600px) {

		.page-header {
			height: 70px;
		}

		.contact-page {
			gap: 55px;
			padding-top: 60px;
			padding-bottom: 75px;
		}

		.contact-intro h1 {
			font-size: 52px;
		}

		.intro-copy {
			font-size: 15px;
		}

		.direct-contact {
			margin-top: 45px;
		}

		.form-wrapper {
			padding: 28px 22px;
		}

		.form-row {
			grid-template-columns: 1fr;
			gap: 28px;
		}

		.form-bottom {
			flex-direction: column;
			align-items: stretch;
			gap: 25px;
		}

		button {
			width: 100%;
		}

		footer {
			grid-template-columns: 1fr auto;
			gap: 8px 20px;
			padding-top: 22px;
			padding-bottom: 22px;
		}

		.footer-site {
			grid-column: 1;
			grid-row: 1;
		}

		.footer-center {
			grid-column: 1 / -1;
			grid-row: 2;
			align-items: flex-start;
			gap: 7px;
		}

		.footer-copy {
			grid-column: 2;
			grid-row: 1;
			text-align: right;
		}

	}


	@media (prefers-reduced-motion: reduce) {

		html {
			scroll-behavior: auto;
		}

		.back-link span,
		button,
		input,
		textarea,
		.skip-link {
			transition: none;
		}

	}


	a:focus-visible,
	button:focus-visible,
	input:focus-visible,
	textarea:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 2px;
		box-shadow: 0 0 0 5px #101312;
	}
</style>