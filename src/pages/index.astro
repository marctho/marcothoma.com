<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #f7f7f5;
		color: #101312;
		font-family:
			Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	:root {
		--page-padding: clamp(24px, 5vw, 76px);
		--accent: #657c70;
		--border: #d9ddda;
		--muted: #616765;
	}

	.header {
		height: 90px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 var(--page-padding);
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
	}

	.logo {
		color: #101312;
		font-size: 22px;
		font-weight: 750;
		text-decoration: none;
		letter-spacing: -0.04em;
	}

	nav {
		display: flex;
		gap: 32px;
	}

	nav a {
		color: #ffffff;
		text-decoration: none;
		font-size: 14px;
		transition: opacity 0.2s ease;
	}

	nav a:hover {
		opacity: 0.6;
	}

	.hero {
		min-height: 720px;
		display: grid;
		grid-template-columns: 53% 47%;
		border-bottom: 1px solid var(--border);
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 140px var(--page-padding) 90px;
	}

	.eyebrow {
		margin: 0 0 30px;
		color: #6b716f;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	h1 {
		font-size: clamp(58px, 6vw, 94px);
		line-height: 0.95;
		letter-spacing: -0.06em;
		margin: 0 0 20px;
		font-weight: 650;
	}

	h1 span {
		color: var(--accent);
	}

	h2 {
		max-width: 680px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(30px, 3.2vw, 49px);
		font-weight: 400;
		line-height: 1.12;
		letter-spacing: -0.035em;
		margin: 0 0 28px;
	}

	.intro {
		max-width: 610px;
		font-size: 16px;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
	}

	.actions {
		display: flex;
		gap: 14px;
		margin-top: 36px;
	}

	.button {
		min-height: 48px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 28px;
		border-radius: 4px;
		padding: 0 22px;
		text-decoration: none;
		font-size: 14px;
		font-weight: 600;
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.primary {
		background: #111514;
		color: white;
	}

	.secondary {
		color: #111514;
		border: 1px solid #cbd0cd;
	}

	.hero-visual {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(
				circle at 25% 45%,
				rgba(255, 255, 255, 0.25),
				transparent 25%
			),
			linear-gradient(135deg, #c8ceca 0%, #59615d 35%, #09100e 72%);
	}

	.orb {
		position: absolute;
		width: 740px;
		height: 740px;
		border-radius: 50%;
		left: -80px;
		top: 110px;
		background:
			radial-gradient(
				circle at 33% 28%,
				rgba(255, 255, 255, 0.85),
				rgba(255, 255, 255, 0.25) 25%,
				rgba(60, 70, 66, 0.25) 48%,
				#07100d 74%
			);
		box-shadow:
			inset -40px -20px 80px rgba(0, 0, 0, 0.55),
			0 0 80px rgba(255, 255, 255, 0.08);
	}

	.orb::after {
		content: "";
		position: absolute;
		inset: 9%;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 50%;
		transform: rotate(-20deg) scaleY(0.55);
	}

	.visual-label {
		position: absolute;
		right: 9%;
		top: 105px;
		color: rgba(255, 255, 255, 0.55);
		font-size: 9px;
		line-height: 1.8;
		letter-spacing: 0.17em;
	}

	.visual-label span {
		display: block;
		width: 25px;
		height: 1px;
		background: rgba(255, 255, 255, 0.6);
		margin-bottom: 15px;
	}

	.counter {
		position: absolute;
		right: 9%;
		bottom: 55px;
		color: white;
		font-size: 12px;
		letter-spacing: 0.12em;
	}

	.work {
		padding: 70px var(--page-padding) 100px;
	}

	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 34px;
	}

	.section-heading p {
		margin: 0;
		font-size: 11px;
		font-weight: 750;
		letter-spacing: 0.18em;
	}

	.section-heading a {
		color: #242827;
		font-size: 13px;
		text-decoration: none;
	}

	.projects {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
	}

	.project {
		border: 1px solid var(--border);
		background: #fbfbfa;
		border-radius: 5px;
		overflow: hidden;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.project:hover {
		transform: translateY(-5px);
		box-shadow: 0 18px 40px rgba(10, 15, 12, 0.08);
	}

	.project-image {
		height: 245px;
		border-bottom: 1px solid var(--border);
		background-color: #d9ddda;
	}

	.project-one {
		background-image: url('/images/projects/masters-thesis.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.project-two {
		background-image: url('/images/projects/masters-project.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.project-three {
		background-image: url('/images/projects/bachelors-thesis.png');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;	
	}

	.project-content {
		padding: 24px;
	}

	.project-type {
		font-size: 10px;
		font-weight: 700;
		color: #777d7a;
		letter-spacing: 0.14em;
		margin: 0 0 12px;
	}

	.project h3 {
		margin: 0 0 14px;
		font-size: 21px;
		line-height: 1.25;
		letter-spacing: -0.025em;
	}

	.project-content > p:not(.project-type) {
		color: var(--muted);
		font-size: 14px;
		line-height: 1.6;
		margin: 0;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin-top: 24px;
	}

	.tags span {
		background: #eceeec;
		padding: 6px 9px;
		border-radius: 3px;
		font-size: 10px;
		color: #555b58;
	}

	.about {
		padding: 90px var(--page-padding) 100px;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.about-label p {
		margin: 0 0 38px;
		font-size: 11px;
		font-weight: 750;
		letter-spacing: 0.18em;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.1fr 1.35fr 0.85fr;
		gap: clamp(40px, 6vw, 100px);
		align-items: start;
	}

	.about-heading h2 {
		margin: 0;
		max-width: 480px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(32px, 3vw, 46px);
		font-weight: 400;
		line-height: 1.12;
		letter-spacing: -0.035em;
