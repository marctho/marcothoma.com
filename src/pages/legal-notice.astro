---
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<title>Legal Notice | Marco Thoma</title>

		<meta
			name="description"
			content="Legal notice and contact information for marcothoma.com."
		/>

		<link rel="canonical" href="https://marcothoma.com/legal-notice" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#101312" />
		<Analytics />
	</head>

	<body>
		<a class="skip-link" href="#main-content">
			Skip to main content
		</a>

		<header class="page-header">
			<a class="logo" href="/">MT</a>

			<a class="back-link" href="/">
				<span>←</span>
				Back home
			</a>
		</header>

		<main id="main-content">

			<!-- HERO -->
			<section class="legal-hero">

				<p class="eyebrow">LEGAL NOTICE</p>

				<h1>
					Legal information,<br />
					<span>kept simple.</span>
				</h1>

				<p class="hero-intro">
					This page provides information about the person responsible
					for marcothoma.com and the use of content published on this website.
				</p>

			</section>


			<!-- RESPONSIBLE PERSON -->
			<section class="legal-section">

				<div class="section-number">01 / RESPONSIBLE PERSON</div>

				<div class="section-copy">

					<h2>Website owner.</h2>

					<div class="contact-block">
						<p>
							<strong>Marco Thoma</strong><br />
							Switzerland<br />
							<a href="https://marcothoma.com">
								marcothoma.com
							</a><br />
							<a href="mailto:marcothoma@bluewin.ch">
								marcothoma@bluewin.ch
							</a>
						</p>
					</div>

					<p>
						For questions concerning this website, its content or
						legal matters relating to marcothoma.com, you can contact
						me using the email address above.
					</p>

				</div>

			</section>


			<!-- CONTENT -->
			<section class="legal-section">

				<div class="section-number">02 / CONTENT</div>

				<div class="section-copy">

					<h2>Responsibility for content.</h2>

					<p>
						The content on this website has been prepared with care
						and is intended to present my background, experience,
						projects and interests.
					</p>

					<p>
						I make reasonable efforts to keep the information accurate
						and up to date. However, I cannot guarantee that all
						information is complete, current or free from errors at
						all times.
					</p>

				</div>

			</section>


			<!-- COPYRIGHT -->
			<section class="legal-section">

				<div class="section-number">03 / COPYRIGHT</div>

				<div class="section-copy">

					<h2>Content and intellectual property.</h2>

					<p>
						Unless otherwise indicated, the texts, design and original
						content published on this website were created for
						marcothoma.com.
					</p>

					<p>
						Content belonging to third parties remains subject to the
						rights of the respective owners. Reproduction, distribution
						or other use of protected material may require the
						permission of the relevant rights holder.
					</p>

				</div>

			</section>


			<!-- EXTERNAL LINKS -->
			<section class="legal-section">

				<div class="section-number">04 / EXTERNAL LINKS</div>

				<div class="section-copy">

					<h2>Links to other websites.</h2>

					<p>
						This website contains links to external websites, including
						platforms such as LinkedIn and GitHub.
					</p>

					<p>
						I do not control the content or availability of external
						websites and am not responsible for changes made to those
						websites after a link has been published here.
					</p>

				</div>

			</section>


			<!-- PRIVACY -->
			<section class="legal-section">

				<div class="section-number">05 / PRIVACY</div>

				<div class="section-copy">

					<h2>Data protection.</h2>

					<p>
						Information about the processing of personal data in
						connection with this website can be found in the&nbsp;
						<a href="/privacy">Privacy Statement</a>.
					</p>

				</div>

			</section>


			<!-- CHANGES -->
			<section class="legal-section">

				<div class="section-number">06 / CHANGES</div>

				<div class="section-copy">

					<h2>Changes to this legal notice.</h2>

					<p>
						This legal notice may be updated if the website or the
						information provided here changes. The version published
						on this page is the current version.
					</p>

				</div>

			</section>

		</main>


		<footer>
			<p class="footer-site">marcothoma.com</p>

			<div class="footer-center">
				<p>Designed & built by Marco Thoma</p>

				<div class="footer-legal">
					<a href="/privacy">Privacy</a>
					<span aria-hidden="true">·</span>
					<a href="/legal-notice">Legal Notice</a>
				</div>
			</div>

			<p class="footer-copy">© 2026</p>
		</footer>

	</body>
</html>


<style>
	:root {
		--background: #f7f7f5;
		--text: #101312;
		--muted: #626966;
		--light-muted: #858b88;
		--border: #d9ddda;
		--accent: #deac53;
		--accent-text: #8f6210;
		--page-padding: clamp(28px, 4vw, 76px);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--background);
		color: var(--text);
		font-family: Arial, Helvetica, sans-serif;
	}

	a {
		color: inherit;
	}


	/* HEADER */

	.page-header {
		height: 84px;
		padding: 0 var(--page-padding);
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}

	.logo {
		font-size: 22px;
		font-weight: 750;
		text-decoration: none;
	}

	.back-link {
		display: flex;
		gap: 10px;
		align-items: center;
		font-size: 12px;
		text-decoration: none;
	}

	.back-link span {
		color: var(--accent);
		transition: transform 0.2s ease;
	}

	.back-link:hover span {
		transform: translateX(-4px);
	}


	/* SKIP LINK */

	.skip-link {
		position: fixed;
		top: 12px;
		left: 50%;
		z-index: 9999;
		padding: 12px 16px;
		background: #101312;
		color: #ffffff;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transform: translate(-50%, -150%);
		transition: transform 0.2s ease;
	}

	.skip-link:focus {
		transform: translate(-50%, 0);
	}


	/* HERO */

	.legal-hero {
		padding: 110px var(--page-padding) 120px;
	}

	.eyebrow {
		margin: 0 0 24px;
		color: var(--light-muted);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.legal-hero h1 {
		max-width: 950px;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(52px, 7vw, 96px);
		font-weight: 400;
		line-height: 0.98;
		letter-spacing: -0.045em;
	}

	.legal-hero h1 span {
		color: var(--accent);
	}

	.hero-intro {
		max-width: 690px;
		margin: 38px 0 0;
		color: var(--muted);
		font-size: 17px;
		line-height: 1.75;
	}


	/* LEGAL CONTENT */

	.legal-section {
		display: grid;
		grid-template-columns: minmax(130px, 0.23fr) 1fr;
		gap: 60px;
		padding: 80px var(--page-padding);
		border-top: 1px solid var(--border);
	}

	.section-number {
		padding-top: 8px;
		color: var(--light-muted);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.section-copy {
		max-width: 850px;
	}

	.section-copy h2 {
		margin: 0 0 32px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(30px, 3vw, 44px);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.section-copy p {
		margin: 0 0 20px;
		color: var(--muted);
		font-size: 15px;
		line-height: 1.8;
	}

	.section-copy p:last-child {
		margin-bottom: 0;
	}

	.section-copy a {
		text-decoration-color: var(--accent);
		text-underline-offset: 3px;
	}

	.section-copy strong {
		color: var(--text);
		font-weight: 700;
	}

	.contact-block {
		margin: 0 0 28px;
		padding: 24px 28px;
		border-left: 2px solid var(--accent);
		background: #eeeeeb;
	}

	.contact-block p {
		margin: 0;
	}


	/* FOOTER */

	footer {
		min-height: 88px;
		padding: 14px var(--page-padding);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 32px;
		align-items: center;
		font-size: 10px;
		color: var(--muted);
		border-top: 1px solid var(--border);
	}

	footer p {
		margin: 0;
	}

	.footer-center {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 7px;
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.footer-legal a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-legal a:hover {
		color: var(--text);
	}

	.footer-legal span {
		color: var(--muted);
	}

	.footer-copy {
		text-align: right;
	}


	/* TABLET */

	@media (max-width: 900px) {

		.legal-hero {
			padding-top: 80px;
			padding-bottom: 90px;
		}

		.legal-section {
			grid-template-columns: 1fr;
			gap: 30px;
			padding-top: 65px;
			padding-bottom: 65px;
		}

	}


	/* MOBILE */

	@media (max-width: 600px) {

		.page-header {
			height: 70px;
		}

		.legal-hero {
			padding-top: 60px;
			padding-bottom: 75px;
		}

		.legal-hero h1 {
			font-size: 48px;
		}

		.hero-intro {
			font-size: 15px;
		}

		.legal-section {
			padding-top: 55px;
			padding-bottom: 55px;
		}

		.section-copy h2 {
			font-size: 30px;
		}

		footer {
			grid-template-columns: 1fr auto;
			gap: 8px 20px;
			padding-top: 22px;
			padding-bottom: 22px;
		}

		.footer-site {
			grid-column: 1;
			grid-row: 1;
		}

		.footer-center {
			grid-column: 1 / -1;
			grid-row: 2;
			align-items: flex-start;
			gap: 7px;
		}

		.footer-copy {
			grid-column: 2;
			grid-row: 1;
			text-align: right;
		}
	}


	@media (prefers-reduced-motion: reduce) {

		html {
			scroll-behavior: auto;
		}

		.back-link span,
		.skip-link {
			transition: none;
		}

	}


	a:focus-visible,
	button:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 2px;
		box-shadow: 0 0 0 5px #101312;
	}
</style>